# Kling (used by `npm run dev`; on Netlify set the same names under
# Site configuration → Environment variables). Never commit a real .env.
# Either the new API key…
KLING_API_KEY=
# …or the older access key + secret key pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Passcode the app must send to use the relay. Required once deployed,
# otherwise anyone who finds the site could spend your Kling credits.
KLING_PROXY_TOKEN=
# Optional: KLING_API_BASE=https://api-singapore.klingai.com
